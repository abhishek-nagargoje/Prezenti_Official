# Prezenti Web - Deployment Environment

# Vercel and normal custom-domain hosting serve from root.
# Only override this for a known subdirectory deployment target.
VITE_BASE_PATH=/
VITE_GA_MEASUREMENT_ID=G-11B7E8EXFS
VITE_CLARITY_PROJECT_ID=x2mspv6g92
# Must be set to the exact production origin (scheme + host, no path/trailing
# slash) for /api/inquiry-notification's server-side origin check to reject
# cross-origin submissions. Verified production domain: https://www.prezenti.com
INQUIRY_ALLOWED_ORIGIN=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
INQUIRY_EMAIL_TO=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=
TWILIO_CONTENT_SID=

# Server-side only — used by backend/serverless functions (e.g. the ICICI
# payment callback handler) to read/write payment_transactions with the
# secret key, which bypasses Row Level Security. NEVER expose this as
# VITE_SUPABASE_SECRET_KEY or any other frontend-visible variable; the
# browser must only ever see VITE_SUPABASE_ANON_KEY.
SUPABASE_SECRET_KEY=
# Legacy fallback only — set SUPABASE_SECRET_KEY above instead for new
# setups. Still read as a fallback (SUPABASE_SECRET_KEY ?? this) for
# projects that only issue the older JWT-format service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# ICICI Bank Orange PG — server-side only. NEVER expose any of these
# (ICICI_HASH_KEY above all) as VITE_*/NEXT_PUBLIC_*/PUBLIC_* variables.
# Production must stay unconfigured/unused until UAT is verified and
# explicitly approved (see docs/icici-orange-pg-integration.md once written).
ICICI_ENV=uat
ICICI_MERCHANT_ID=
ICICI_AGGREGATOR_ID=
ICICI_HASH_KEY=
ICICI_CURRENCY_CODE=356
ICICI_PAY_TYPE=0
ICICI_TRANSACTION_TYPE=SALE
ICICI_UAT_INITIATE_SALE_URL=https://pgpayuat.icicibank.com/tsp/pg/api/v2/initiateSale
ICICI_UAT_COMMAND_URL=https://pgpayuat.icicibank.com/tsp/pg/api/command
ICICI_UAT_SETTLEMENT_DETAILS_URL=https://pgpayuat.icicibank.com/tsp/pg/api/settlementDetails
ICICI_RETURN_URL=
